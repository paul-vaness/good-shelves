{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "good shelves",
  "version": "1.0.4",
  "identifier": "edu.ccgc.goodshelves",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "good shelves — local semantic file manager",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:* asset: https://asset.localhost; img-src 'self' data: blob: http://127.0.0.1:* asset: https://asset.localhost; media-src 'self' blob: http://127.0.0.1:* asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$DESKTOP/**",
          "$PICTURE/**",
          "$APPDATA/**",
          "$LOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Calaca City Global College",
    "homepage": "https://github.com/paul-vaness/good-shelves",
    "windows": {
      "bundleVCRuntime": true,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
